{
  // AIによるコード生成は停止
  "github.copilot.enable": {
    "*": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "editor.inlineSuggest.enabled": false,

  // IntelliSenseによる関数・変数・ライブラリAPI候補を表示
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },

  // 「.」の入力後にメソッドやプロパティ候補を表示
  "editor.suggestOnTriggerCharacters": true,

  // 引数・型情報を表示
  "editor.parameterHints.enabled": true,

  // 単なる文章上の類似単語からの候補は無効化
  // 言語サーバーが把握している正規のシンボル候補は残る
  "editor.wordBasedSuggestions": "off",

  // 定型コードのスニペット候補は不要なら無効化
  "editor.snippetSuggestions": "none",
  // 未定義の変数・関数や型の不一致をエディターに表示
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled",
  "editor.renderValidationDecorations": "on",

  // 解析した型・関数・変数に応じて色分け
  "C_Cpp.enhancedColorization": "enabled",
  "[cpp]": {
    "editor.semanticHighlighting.enabled": true
  },

  // CMakeのビルド設定からSDL2の情報を取得
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureOnOpen": true,

  // CMake未構成時やビルド対象外の.cppにも実環境と同じ設定を使用
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src",
    "C:/msys64/ucrt64/include/SDL2"
  ]
}
